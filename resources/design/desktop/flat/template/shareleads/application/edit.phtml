function resetContractForm() {
    $('#contract_title').val('');
    $('#contract_id').val('');
    $('#contract_customer_id').val('');
    $('#contract_pdf_url').val('');
    $('#contract_description').val('');
}
$('#contractForm').submit(function(e) {
    $("#mask").show();
    e.preventDefault();

    // Create a FormData object to store all form data
    var fd = new FormData(this);

    // Append the file input to FormData if it exists
    var files = $('#contract_pdf_url')[0].files;
    if (files.length > 0) {
        fd.append('file', files[0]);
    }

    // Make the POST request
    $.ajax({
        url: this.action,
        type: 'post',
        data: fd,
        contentType: false,
        processData: false,
    }).done(function(response) {
        var res = JSON.parse(response);
        console.log(res);
        if (res.message != '') {
            Swal.fire({
                position: "top-end",
                icon: "success",
                title: res.message,
                showConfirmButton: false,
                timer: 1500
            });
        }
        resetContractForm();
        reloadContracts();
        // if (res.success == true && res.message == "") {
        //     location.reload(); // Reload the page
        // } else {
        //     // Handle other cases if needed
        // }
    }).fail(function(response) {
        console.log("Error Response");
        var errorRes = JSON.parse(response.responseText); // Convert error responseText to object
        console.log(errorRes);
        if (errorRes.message != '') {
            Swal.fire({
                icon: "error",
                title: "<?php echo p__("shareleads",'Error'); ?>",
                html: errorRes.message,
            });
            // alert(errorRes.message); // Show message from error response
        } else {
            alert("Error"); // Default error message
        }
    }).always(function(response) {
        $("#mask").hide();
    });
    return false;
});

function setContractForm(contract_id) {
    resetContractForm();
    url = '<?php echo $this->getUrl('shareleads/application/set-contract-form'); ?>/contract_id/' + contract_id +
        "/value_id/<?php echo $option->getId();?>";
    reload(this, url, true, function(response) {
        console.log(response);
        if (response.contract && Object.keys(response.contract).length > 0) {
            $('#contract_title').val(response.contract.contract_title);
            $('#contract_id').val(response.contract.contract_id);
            $('#contract_customer_id').val(response.contract.customer_id);
            $('#contract_pdf_url').val('');
            $('#contract_description').val(response.contract.contract_description);
        }
    });
}

function uploadContract(contract_id = 0) {
    $('#contractForm').slideDown();
    if (contract_id != 0) {
        setContractForm(contract_id);
        $('#contract_id').val(contract_id);
    } else {
        $('#contract_id').val('');
    }
}

