let leder_table = {
    tolerance: 180,
    mask: null,
    processEvents: function() {
        $('#btn_leder_table_manager').unbind('click');
        $('#btn_leder_table_manager').click(function() {
            leder_table.open();
        });

        $('.close_modal_leder_table_manager').unbind('click');
        $('.close_modal_leder_table_manager').click(function() {
            leder_table.close(true);
        });
    },
    open: function(agent_id) {
        // alert(id);
        var ref = this;
        $('#mask').show();
        $.ajax({
                url: '<?php echo $this->getUrl('shareleads/application/get-leders'); ?>',
                type: 'POST',
                dataType: 'html',
                data: {
                    app_id: <?php echo $app_id; ?>,
                    value_id: <?php echo $value_id; ?>,
                    agent_id: agent_id,
                }
            })
            .done(function(data) {
                $('#mask').hide("fast", function() {
                    $(document).keyup(function(e) {
                        if (e.which == 27) leder_table.close(true);
                    });

                    $(window).unbind('resize');
                    $(window).resize(ref.resize.bind(ref));

                    ref.resize();

                    $('#leder-table-data').html(data);

                    $('#leder_table_manager').fadeIn();
                });
            })
            .fail(function(data) {
                $('#mask').hide();
            })
            .always(function() {
                $('#mask').hide();
            });
        /* $(document).keyup(function (e) {
        	if (e.which == 27) leder_table.close(true);
        });

        $(window).unbind('resize');
        $(window).resize(this.resize.bind(this));

        this.resize();

        $('#leder_table_manager').fadeIn(); */

    },
    close: function(animated) {
        if (animated) {
            $('#leder_table_manager').fadeOut(300, function() {});
        } else {
            $('#leder_table_manager').hide();
        }
        $(document).unbind('keyup');
    },
    resize: function(all) {
        let selector = ".leder_table_details";
        if (!all) {
            selector += ":visible";
        }
        $('#leder_table').css('height', $(window).outerHeight() - 75);
        $('#leder_table_manager').find(selector).css('height', $(window).outerHeight() - this
            .tolerance);
    }
};
leder_table.processEvents();


