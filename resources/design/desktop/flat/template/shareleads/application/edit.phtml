function toggleStatus(customer_id, e) {
    console.log(customer_id, e);
    if (confirm(
            "<?php echo p__("shareleads", 'Do you wish to alter the user status?'); ?>"
        )) {
        url =
            "<?php echo $this->getUrl('shareleads/user/toggle-status'); ?>/value_id/<?php echo $value_id;?>/customer_id/" +
            customer_id;
        reload(this, url, true, function(data) {
            if (data.success) {
                if (data.is_admin == 1) {
                    $(e).addClass("fa-user").removeClass("fa-user-o");
                } else {
                    $(e).addClass("fa-user-o").removeClass("fa-user");
                }

            }
        });
    }

}

