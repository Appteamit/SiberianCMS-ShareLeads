                }
            });
        } else if (
            result.dismiss === Swal.DismissReason.cancel
        ) {
            Swal.fire({
                icon: 'error',
                title: "<?php echo p__("shareleads",'Your contract is safe :)');?>",
                showConfirmButton: false,
                timer: 1500
            })
        }
    });
}

