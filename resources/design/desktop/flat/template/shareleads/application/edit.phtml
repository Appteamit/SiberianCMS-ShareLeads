$('#email_type').on('change', function() {
    if ($(this).val() != '') {
        get_email_notification();
    } else {
        $('#email_text').val('');
        $('#email_ccn').val('');
        $('#email_object').val('');
        $('#new_admin_tags').hide();
        $('#csv_file_tags').hide();
    }

});

function get_email_notification() {
    $('#email_text').val('');
    $('#email_ccn').val('');
    $('#email_object').val('');

    email_type = $('#email_type').val();
    if (email_type == 'new_admin') {
        $('#new_admin_tags').show();
    } else {
        $('#new_admin_tags').hide();
    }
    if (email_type == 'csv_file') {
        $('#csv_file_tags').show();
    } else {
        $('#csv_file_tags').hide();
    }
    url =
        '<?php echo $this->getUrl('shareleads/email/getemaildata'); ?>/value_id/<?php echo $value_id;?>/email_type/' +
        email_type;
    reload(this, url, true, function(data) {
        if (data.success) {
            $('#email_text').val(data.data.email_text);
            $('#email_object').val(data.data.email_object);
            $('#email_ccn').val(data.data.email_ccn);

        } else {
            $('#email_text').val(data.default_admin_template.text);
            $('#email_ccn').val('');
            $('#email_object').val(data.default_admin_template.subject);
        }
    });

}
