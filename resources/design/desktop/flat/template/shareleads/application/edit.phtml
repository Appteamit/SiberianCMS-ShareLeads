function editProduct(product_id = 0) {
    $('#product_form').slideDown();
    resetProduct();
    $('#product_id').val(product_id);
    $('#product_description').val('');
    url = '<?php echo $this->getUrl('shareleads/product/get-product'); ?>/product_id/' + product_id +
        "/value_id/<?php echo $option->getId();?>";
    reload(this, url, true, function(response) {
        console.log(response);
        if (response.product && Object.keys(response.product).length > 0) {
            $('#product_id').val(response.product.product_id);
            $('#product_name').val(response.product.product_name);
            $('#product_points').val(response.product.product_points);
            $('#product_start_at').val(response.product.product_start_at);
            $('#product_expire_at').val(response.product.product_expire_at);
            $('#product_status').val(response.product.product_status);
            $('#product_description').val(response.product.product_description);

            if (response.product.product_img == null || response.product.product_img == "") {
                $('#show_product_img').hide().attr('src', '');
                $('#product_img').val('');
                // $('#remove_product_img').hide();
            } else {
                image_url = '<?php echo $base_url;?>/images/application/' + '<?php echo $app_id;?>' +
                    '/features/shareleads/' + response.product.product_img;
                $('#show_product_img').hide().attr('src', image_url).slideDown();
                $('#product_img').val(response.product.product_img);
                // $('#remove_product_img').show();
            }
        }
    });
}

